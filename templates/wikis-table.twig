<div class="modal fade"
     id="upgrade-selected-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="upgrade-selected-modal-label"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="upgrade-selected-modal-label">
                    <i id="upgrade-selected-modal-icon" class="fas fa-sync-alt"></i>
