{{ include_javascript("tools/templates/libs/vendor/datatables/dataTables.bootstrap.min.js") }}
{{ include_javascript("tools/templates/libs/vendor/datatables/jquery.dataTables.min.js") }}
{{ include_css("tools/templates/libs/vendor/datatables/dataTables.bootstrap.min.css") }}
<h2>{{ _t("FERME_ALL_WIKIS_ADMIN") }}</h2>
<div class="table-responsive">
    <table id="wikis-table"
           class="no-dblclick datatable table table-condensed table-striped prevent-auto-init"
           data-api-url="{{ api_url }}"
           data-i18n-see="{{ _t("BAZ_SEE_ENTRY") }}"
           data-i18n-edit="{{ _t("BAZ_MODIFIER") }}"
           data-i18n-backup="{{ _t("FERME_BACKUP") }}"
           data-i18n-delete="{{ _t("BAZ_SUPPRIMER") }}"
           data-i18n-confirm-delete="{{ _t("BAZ_CONFIRMATION_SUPPRESSION") }}">
        <thead>
            <tr>
                <th data-orderable="false" data-sortable="false"></th>
                <th>{{ _t("FERME_WIKI_NAME") }}</th>
                <th>{{ _t("FERME_WIKI_OWNER") }}</th>
                <th>{{ _t("FERME_WIKI_LAST_UPDATE") }}</th>
                <th data-orderable="false" data-sortable="false">{{ _t("FERME_WIKI_ADMIN") }}</th>
                <th data-orderable="false" data-sortable="false">{{ _t("FERME_WIKI_VERSION") }}</th>
                <th data-orderable="false" data-sortable="false">{{ _t("FERME_WIKI_ACTION") }}</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
<!-- /.table-responsive -->
<div class="clearfix" style="margin-top:10px;">
    <div class="checkbox" style="display:inline-block; margin-right:10px;">
        <label>
            <input type="checkbox" id="select-all-wikis">
            <span>{{ _t("FERME_SELECT_ALL") }}</span>
        </label>
    </div>
    <button id="btn-upgrade-selected"
            type="button"
            class="btn btn-warning"
            disabled>
        <i class="fas fa-sync-alt"></i> {{ _t("FERME_UPGRADE_SELECTED_WIKIS") }}
        <span id="upgrade-selected-count" class="badge" style="display:none;"></span>
    </button>
    <button id="btn-delete-selected"
            type="button"
            class="btn btn-danger"
            disabled>
        <i class="fas fa-trash"></i> {{ _t("FERME_DELETE_SELECTED_WIKIS") }}
        <span id="delete-selected-count" class="badge" style="display:none;"></span>
    </button>
</div>
<div id="upgrade-wikis-config"
     style="display:none"
     data-upgrade-url="{{ upgrade_api_url }}"
     data-delete-url="{{ delete_api_url }}"
     data-csrf-token="{{ csrfToken({id: "main", refresh: false}) }}"
     data-pending="{{ _t("FERME_UPGRADE_PENDING") }}"
     data-in-progress="{{ _t("FERME_UPGRADING_STATUS") }}"
     data-success="{{ _t("FERME_UPGRADE_SUCCESS") }}"
     data-error="{{ _t("FERME_UPGRADE_ERROR") }}"
     data-delete-warning="{{ _t("FERME_DELETE_SELECTED_WARNING") }}"
     data-delete-confirm-btn="{{ _t("FERME_DELETE_CONFIRM_BTN") }}"
     data-deleting="{{ _t("FERME_DELETING_STATUS") }}"
     data-delete-success="{{ _t("FERME_DELETE_SUCCESS") }}"
     data-delete-error="{{ _t("FERME_DELETE_ERROR") }}"
     data-cancel="{{ _t("FERME_CANCEL") }}"
     data-close="{{ _t("FERME_UPGRADE_CLOSE") }}"></div>
{{ include_javascript("tools/ferme/javascripts/wikis-table.js") }}

{# Upgrade modal #}
<div class="modal fade"
     id="upgrade-selected-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="upgrade-selected-modal-label"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="upgrade-selected-modal-label">
                    <i class="fas fa-sync-alt"></i> {{ _t("FERME_UPGRADE_SELECTED_WIKIS") }}
                </h4>
            </div>
            <div class="modal-body">
                <p class="text-muted">{{ _t("FERME_UPGRADE_SELECTED_INTRO") }}</p>
                <div id="upgrade-wikis-list"
                     class="list-group"
                     style="max-height:400px; overflow-y:auto"></div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        id="btn-close-upgrade-modal"
                        class="btn btn-default"
                        data-dismiss="modal"
                        disabled>{{ _t("FERME_UPGRADE_CLOSE") }}</button>
            </div>
        </div>
    </div>
</div>

{# Delete modal #}
<div class="modal fade"
     id="delete-selected-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="delete-selected-modal-label"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="delete-selected-modal-label">
                    <i class="fas fa-trash"></i> {{ _t("FERME_DELETE_SELECTED_WIKIS") }}
                </h4>
            </div>
            <div class="modal-body">
                <div id="delete-confirm-stage">
                    <div class="alert alert-danger">{{ _t("FERME_DELETE_SELECTED_WARNING") }}</div>
                    <div id="delete-wikis-preview" class="list-group" style="max-height:300px; overflow-y:auto"></div>
                </div>
                <div id="delete-progress-stage" style="display:none">
                    <div id="delete-wikis-list" class="list-group" style="max-height:400px; overflow-y:auto"></div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="delete-footer-confirm">
                    <button type="button"
                            class="btn btn-default"
                            data-dismiss="modal">{{ _t("FERME_CANCEL") }}</button>
                    <button type="button"
                            id="btn-start-delete"
                            class="btn btn-danger">
                        <i class="fas fa-trash"></i> {{ _t("FERME_DELETE_CONFIRM_BTN") }}
                    </button>
                </div>
                <div id="delete-footer-progress" style="display:none">
                    <button type="button"
                            id="btn-close-delete-modal"
                            class="btn btn-default"
                            data-dismiss="modal"
                            disabled>{{ _t("FERME_UPGRADE_CLOSE") }}</button>
                </div>
            </div>
        </div>
    </div>
</div>

<a class="btn btn-primary"
   role="button"
   href="{{ url({"handler": "searchwiki"}) }}"><i class="fas fa-search-plus"></i> {{ _t("FERME_SEARCH_FOR_WIKIS") }}</a>
