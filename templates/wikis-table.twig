<h2>{{ _t("FERME_ALL_WIKIS_ADMIN") }}</h2>
<style>
#wikis-table_processing {
    position: fixed;
    transform: translate(-50%, -50%);
    margin: 0;
    z-index: 1000;
}
.ferme-dashboard {
    --ferme-accent: var(--primary-color, #1a89a0);
    --ferme-line: rgba(127, 127, 127, 0.22);
    --ferme-soft: rgba(127, 127, 127, 0.07);
    margin-bottom: 16px;
}
.ferme-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    gap: 10px;
    margin-bottom: 14px;
}
.ferme-tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--ferme-line);
    border-radius: 10px;
    background: var(--ferme-soft);
    line-height: 1.15;
    transition: border-color .15s, box-shadow .15s;
}
.ferme-tile-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: .8em;
    opacity: .7;
}
.ferme-tile strong {
    font-size: 1.5em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}
.ferme-total-filter {
    cursor: pointer;
}
.ferme-total-filter:hover {
    border-color: var(--ferme-accent);
}
.ferme-total-filter.active {
    border-color: var(--ferme-accent);
    box-shadow: inset 0 0 0 1px var(--ferme-accent);
}
.ferme-total-filter.active .ferme-tile-label {
    color: var(--ferme-accent);
    opacity: 1;
}
.ferme-toolbar {
    border: 1px solid var(--ferme-line);
    border-radius: 10px;
    padding: 4px 12px;
}
.ferme-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    padding: 8px 0;
}
.ferme-filter-row + .ferme-filter-row {
    border-top: 1px solid var(--ferme-line);
}
#ferme-lifetime-chips.ferme-filter-row {
    border-top: 0;
}
.ferme-filter-label {
    flex: 0 0 110px;
    font-size: .85em;
    opacity: .7;
}
.ferme-chips {
    display: contents;
}
.ferme-chip,
.ferme-lifetime-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: 1px solid var(--ferme-line);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: .85em;
    line-height: 1.5;
    transition: background-color .15s, border-color .15s, color .15s;
}
.ferme-chip:hover,
.ferme-lifetime-chip:hover {
    border-color: var(--ferme-accent);
}
.ferme-chip .badge,
.ferme-lifetime-chip .badge {
    background: var(--ferme-soft);
    color: inherit;
    font-weight: 600;
}
.ferme-chip-danger i { color: #c0392b; }
.ferme-chip-warning i { color: #d68910; }
.ferme-chip-info i { color: #2e86c1; }
.ferme-chip-default i { opacity: .6; }
.ferme-chip.active,
.ferme-lifetime-chip.active {
    background: var(--ferme-accent);
    border-color: var(--ferme-accent);
    color: #fff;
}
.ferme-chip.active i,
.ferme-lifetime-chip.active i {
    color: inherit;
    opacity: 1;
}
.ferme-chip.active .badge,
.ferme-lifetime-chip.active .badge {
    background: rgba(255, 255, 255, 0.25);
}
.ferme-sort-row select.form-control,
.ferme-sort-row .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: auto;
    height: 30px;
    padding: 3px 12px;
    border: 1px solid var(--ferme-line);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: .85em;
    box-shadow: none;
}
.ferme-sort-row select.form-control {
    display: inline-block;
    padding-right: 28px;
}
.ferme-sort-row select.form-control:hover,
.ferme-sort-row .btn:hover {
    border-color: var(--ferme-accent);
}
.ferme-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    white-space: nowrap;
}
.ferme-figure {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.ferme-figure i {
    opacity: 0.55;
}
.ferme-sparkline {
    vertical-align: middle;
}
.ferme-muted {
    opacity: 0.6;
}
.ferme-identity strong {
    display: block;
}
.ferme-open-wiki {
    margin-left: 6px;
    font-size: 0.85em;
    opacity: 0.55;
}
.ferme-open-wiki:hover,
.ferme-open-wiki:focus {
    opacity: 1;
}
.ferme-identity small {
    display: block;
    opacity: 0.75;
}
#wikis-table td {
    vertical-align: middle;
}
.ferme-detail {
    padding: 4px 2px;
}
.ferme-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 4px 18px;
}
.ferme-detail-cell i {
    opacity: 0.55;
}
.ferme-detail-note {
    font-size: 0.9em;
    margin-top: 6px;
}
.ferme-progress {
    float: right;
    opacity: 0.7;
    font-weight: normal;
}
.ferme-detail-title {
    margin-top: 12px;
    font-weight: bold;
}
.ferme-spam-pages {
    margin: 4px 0 0;
    padding-left: 18px;
    max-height: 240px;
    overflow-y: auto;
}
.ferme-spam-pages li {
    line-height: 1.7;
}
.ferme-calendar {
    margin-top: 4px;
    max-width: 780px;
}
#wikis-table thead th.ferme-sortable {
    cursor: pointer;
    white-space: nowrap;
}
#wikis-table thead th.ferme-sortable:hover {
    text-decoration: underline;
}
.ferme-sort-arrow {
    opacity: 0.6;
    margin-left: 4px;
}
.ferme-bulk {
    margin-top: 10px;
    padding: 10px 14px 12px;
    border: 1px solid rgba(127, 127, 127, 0.3);
    border-radius: 4px;
}
.ferme-bulk-head {
    font-weight: bold;
    margin-bottom: 8px;
}
.ferme-bulk-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px 24px;
}
.ferme-bulk-title {
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
    margin-bottom: 3px;
}
.ferme-bulk-action {
    display: block;
    padding: 3px 0;
}
.ferme-bulk-action i {
    opacity: 0.55;
}
#wikis-table tbody tr {
    cursor: pointer;
}
#wikis-table tbody tr.ferme-open > td,
#wikis-table tbody tr.ferme-child > td {
    background-color: rgba(127, 127, 127, 0.12);
}
#wikis-table tbody tr.ferme-open > td {
    border-bottom: 0;
}
@media (max-width: 767px) {
    #wikis-table,
    #wikis-table tbody,
    #wikis-table tr,
    #wikis-table td {
        display: block;
        width: auto;
    }
    #wikis-table thead {
        display: none;
    }
    #wikis-table tr {
        border-bottom: 1px solid rgba(127, 127, 127, 0.3);
        padding: 6px 0;
    }
    .ferme-filter-label {
        flex-basis: 100%;
    }
}
</style>
