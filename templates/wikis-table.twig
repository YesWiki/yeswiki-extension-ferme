<h2>{{ _t("FERME_ALL_WIKIS_ADMIN") }}</h2>
<style>
#wikis-table_processing {
    position: fixed;
    transform: translate(-50%, -50%);
    margin: 0;
    z-index: 1000;
}
.ferme-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    margin-bottom: 12px;
}
.ferme-total {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
}
.ferme-total strong {
    font-size: 1.4em;
}
.ferme-total span {
    opacity: 0.7;
    font-size: 0.85em;
}
.ferme-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
}
.ferme-chip.active {
    box-shadow: inset 0 0 0 2px currentColor;
}
.ferme-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    white-space: nowrap;
}
.ferme-figure {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.ferme-figure i {
    opacity: 0.55;
}
.ferme-sparkline {
    vertical-align: middle;
}
.ferme-muted {
    opacity: 0.6;
}
.ferme-identity strong {
    display: block;
}
.ferme-open-wiki {
    margin-left: 6px;
    font-size: 0.85em;
    opacity: 0.55;
}
.ferme-open-wiki:hover,
.ferme-open-wiki:focus {
    opacity: 1;
}
.ferme-identity small {
    display: block;
    opacity: 0.75;
}
#wikis-table td {
    vertical-align: middle;
}
.ferme-detail {
    padding: 4px 2px;
}
.ferme-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 4px 18px;
}
.ferme-detail-cell i {
    opacity: 0.55;
}
.ferme-detail-note {
    font-size: 0.9em;
    margin-top: 6px;
}
.ferme-progress {
    float: right;
    opacity: 0.7;
    font-weight: normal;
}
.ferme-detail-title {
    margin-top: 12px;
    font-weight: bold;
}
.ferme-calendar {
    margin-top: 4px;
    max-width: 780px;
}
#wikis-table tbody tr {
    cursor: pointer;
}
#wikis-table tbody tr.ferme-open > td,
#wikis-table tbody tr.ferme-child > td {
    background-color: rgba(127, 127, 127, 0.12);
}
#wikis-table tbody tr.ferme-open > td {
    border-bottom: 0;
}
@media (max-width: 767px) {
    #wikis-table,
    #wikis-table tbody,
    #wikis-table tr,
    #wikis-table td {
        display: block;
        width: auto;
    }
    #wikis-table thead {
        display: none;
    }
    #wikis-table tr {
        border-bottom: 1px solid rgba(127, 127, 127, 0.3);
        padding: 6px 0;
    }
    .ferme-chips {
        margin-left: 0;
    }
}
</style>
