{% import _self as ferme %}
{{ include_css('extensions/ferme/styles/ferme.css') }}
{{ include_javascript('extensions/ferme/javascripts/wikis-table.js') }}
{% set pageUrl = url({}) %}
{% set pageQuery = (pageUrl|split('?', 2))[1]|default('') %}
<div class="ferme" id="ferme-wikis">
  <script type="application/json" class="ferme-config">{{ {
    api: api,
    csrf: csrfToken,
    query: {ferme_search: state.search, ferme_filter: state.filter, ferme_lifetime: state.lifetime},
    filtered: filtered,
    i18n: {
      close: _t('FERME_UPGRADE_CLOSE'),
      cancel: _t('FERME_CANCEL'),
      start: _t('FERME_RUN_START'),
      pending: _t('FERME_UPGRADE_PENDING'),
      running: _t('FERME_UPGRADING_STATUS'),
      done: _t('FERME_UPGRADE_SUCCESS'),
      failed: _t('FERME_UPGRADE_ERROR'),
      summary: _t('FERME_RUN_SUMMARY'),
      nothingSelected: _t('FERME_SEARCH_IMPORT_NONE'),
      selectAll: _t('FERME_SELECT_ALL_N'),
      selectNone: _t('FERME_SELECT_NONE'),
      selecting: _t('FERME_SELECTING'),
      selected: _t('FERME_SELECTED_COUNT'),
      loading: _t('FERME_STATS_LOADING'),
      download: _t('FERME_ARCHIVE_DOWNLOAD'),
      archiveMade: _t('FERME_ARCHIVE_MADE'),
      mailSubject: _t('FERME_MAIL_SUBJECT'),
      mailBody: _t('FERME_MAIL_BODY'),
      mailPlaceholders: _t('FERME_MAIL_PLACEHOLDERS'),
      mailSend: _t('FERME_MAIL_SEND'),
      mailEmpty: _t('FERME_MAIL_EMPTY'),
      searchIntro: _t('FERME_SEARCH_INTRO'),
      searchScanning: _t('FERME_SEARCH_SCANNING'),
      searchImport: _t('FERME_SEARCH_IMPORT_SELECTED'),
      searchImported: _t('FERME_SEARCH_IMPORTED_STATUS'),
      searchError: _t('FERME_SEARCH_NETWORK_ERROR'),
      searchNone: _t('FERME_SEARCH_NOTHING'),
      searchEmail: _t('FERME_SEARCH_EMAIL'),
      neverMeasured: _t('FERME_SEARCH_NEVER_EDITED'),
      folder: _t('FERME_CLI_COL_FOLDER'),
      pages: _t('FERME_SORT_PAGES'),
      entries: _t('FERME_SORT_ENTRIES'),
      users: _t('FERME_SORT_USERS'),
      lastActivity: _t('FERME_SORT_ACTIVITY'),
      detailError: _t('FERME_DETAIL_ERROR'),
      actions: {
        'migrate': {title: _t('FERME_MIGRATE_SELECTED'), intro: _t('FERME_MIGRATE_INTRO')},
        'refresh-stats': {title: _t('FERME_REFRESH_STATS_SELECTED'), intro: _t('FERME_REFRESH_STATS_INTRO')},
        'archive': {title: _t('FERME_ARCHIVE_SELECTED'), intro: _t('FERME_ARCHIVE_INTRO')},
        'hibernate': {title: _t('FERME_HIBERNATE_SELECTED'), intro: _t('FERME_HIBERNATE_INTRO'), danger: true},
        'wake': {title: _t('FERME_WAKE_SELECTED'), intro: _t('FERME_WAKE_INTRO')},
        'admin-add': {title: _t('FERME_ADMIN_ADD_SELECTED'), intro: _t('FERME_ADMIN_ADD_SELECTED_INTRO')},
        'admin-remove': {title: _t('FERME_ADMIN_REMOVE_SELECTED'), intro: _t('FERME_ADMIN_REMOVE_SELECTED_INTRO'), danger: true},
        'clean-spam-dry': {title: _t('FERME_CLEAN_DRY_SELECTED'), intro: _t('FERME_CLEAN_DRY_INTRO')},
        'clean-spam': {title: _t('FERME_CLEAN_SELECTED'), intro: _t('FERME_CLEAN_INTRO'), danger: true},
        'delete': {title: _t('FERME_DELETE_SELECTED_WIKIS'), intro: _t('FERME_DELETE_SELECTED_WARNING'), danger: true, confirm: _t('FERME_DELETE_CONFIRM_BTN')},
        'mail': {title: _t('FERME_MAIL_SELECTED'), intro: _t('FERME_MAIL_INTRO')},
        'lifetime': {title: _t('FERME_LIFETIME_CHANGE'), intro: _t('FERME_LIFETIME_CHANGE_INTRO')},
        'search': {title: _t('FERME_SEARCH_FOR_WIKIS'), intro: _t('FERME_SEARCH_INTRO')}
      }
    }
  }|json_encode|raw }}</script>

  <div class="ferme-tiles">
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.wikis }}</span><span class="ferme-tile__label">{{ _t('FERME_TOTAL_WIKIS') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.running }}</span><span class="ferme-tile__label">{{ _t('FERME_STATUS_RUNNING') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.hibernating }}</span><span class="ferme-tile__label">{{ _t('FERME_STATUS_HIBERNATE') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.entries }}</span><span class="ferme-tile__label">{{ _t('FERME_SORT_ENTRIES') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.pages }}</span><span class="ferme-tile__label">{{ _t('FERME_SORT_PAGES') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.users }}</span><span class="ferme-tile__label">{{ _t('FERME_SORT_USERS') }}</span></div>
    <div class="ferme-tile"><span class="ferme-tile__value">{{ totals.disk }}</span><span class="ferme-tile__label">{{ _t('FERME_STATS_DISK') }}</span></div>
    {% if totals.measured < totals.wikis %}
      <p class="ferme-tiles__note">{{ _t('FERME_TOTALS_PARTIAL', {measured: totals.measured, wikis: totals.wikis}) }}</p>
    {% endif %}
  </div>

  <form class="ferme-toolbar" method="get" action="{{ pageUrl }}">
    {% if pageQuery != '' and '=' not in pageQuery %}<input type="hidden" name="wiki" value="{{ pageQuery }}">{% endif %}
    {% if state.filter %}<input type="hidden" name="ferme_filter" value="{{ state.filter }}">{% endif %}
    {% if state.lifetime %}<input type="hidden" name="ferme_lifetime" value="{{ state.lifetime }}">{% endif %}
    <label class="ferme-toolbar__search">
      <span class="ferme-visually-hidden">{{ _t('FERME_SEARCH_LABEL') }}</span>
      <input type="search" class="yw-input" name="ferme_search" value="{{ state.search }}" placeholder="{{ _t('FERME_SEARCH_LABEL') }}">
    </label>
    <label class="ferme-toolbar__sort">
      <span>{{ _t('FERME_SORT_BY') }}</span>
      <select class="yw-input" name="ferme_sort" data-ferme-autosubmit>
        {% for sort in sorts %}
          <option value="{{ sort }}"{% if sort == state.sort %} selected{% endif %}>{{ _t('FERME_SORT_' ~ {title: 'TITLE', referent: 'REFERENT', lastActivity: 'ACTIVITY', activity: 'TOTAL_ACTIVITY', entries: 'ENTRIES', pages: 'PAGES', users: 'USERS', forms: 'FORMS', diskBytes: 'DISK'}[sort]) }}</option>
        {% endfor %}
      </select>
    </label>
    <select class="yw-input ferme-toolbar__way" name="ferme_way" data-ferme-autosubmit aria-label="{{ _t('FERME_SORT_BY') }}">
      <option value="asc"{% if state.way == 'asc' %} selected{% endif %}>{{ _t('FERME_SORT_ASC') }}</option>
      <option value="desc"{% if state.way == 'desc' %} selected{% endif %}>{{ _t('FERME_SORT_DESC') }}</option>
    </select>
    <button type="submit" class="yw-btn yw-btn--sm">{{ icon('loupe') }} {{ _t('FERME_SEARCH_LABEL') }}</button>
    {% if state.search or state.filter or state.lifetime %}
      <a class="yw-btn yw-btn--sm" href="{{ clearUrl }}">{{ icon('x') }} {{ _t('FERME_FILTER_CLEAR') }}</a>
    {% endif %}
    <button type="button" class="yw-btn yw-btn--sm ferme-toolbar__end" data-ferme-search>{{ icon('server') }} {{ _t('FERME_SEARCH_FOR_WIKIS') }}</button>
  </form>

  {% for group in [{label: _t('FERME_WATCH'), chips: chips}, {label: _t('FERME_LIFETIME'), chips: lifetimeChips}, {label: _t('FERME_LIFETIME_STATE'), chips: stateChips}] %}
    {% if group.chips is not empty %}
      <div class="ferme-chips">
        <span class="ferme-chips__label">{{ group.label }}</span>
        {% for chip in group.chips %}
          <a class="ferme-chip ferme-chip--{{ chip.kind }}{% if chip.active %} ferme-chip--active{% endif %}" href="{{ chip.url }}"{% if chip.active %} aria-current="true"{% endif %}>
            {{ icon(chip.icon) }} {{ chip.label }} <span class="ferme-chip__count">{{ chip.count }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

  <div class="ferme-selection" hidden>
    <span class="ferme-selection__count"></span>
    <button type="button" class="yw-btn yw-btn--sm" data-ferme-select-all>{{ _t('FERME_SELECT_ALL_N', {n: filtered}) }}</button>
    <button type="button" class="yw-btn yw-btn--sm" data-ferme-select-none>{{ _t('FERME_SELECT_NONE') }}</button>
    <div class="yw-dropdown">
      <button type="button" class="yw-btn yw-btn--sm yw-btn--primary" data-yw-dropdown-toggle aria-expanded="false">{{ _t('FERME_SELECTION_ACTIONS') }} <span class="yw-dropdown__caret"></span></button>
      <ul class="yw-dropdown__menu">
        {{ ferme.actionItems(farmAdmin, lifetimeEnabled, lifetimeKinds, null) }}
      </ul>
    </div>
  </div>

  {% if rows is empty %}
    <p class="yw-alert yw-alert--info">{{ total == 0 ? _t('FERME_NO_WIKIS') : _t('FERME_NO_WIKI_MATCHES') }}</p>
  {% else %}
    <div class="ferme-table-wrap">
      <table class="yw-table ferme-table">
        <thead>
          <tr>
            <th class="ferme-table__check"><input type="checkbox" data-ferme-check-page aria-label="{{ _t('FERME_SELECT_PAGE') }}"></th>
            <th>{{ _t('FERME_WIKI_NAME') }}</th>
            <th>{{ _t('FERME_WIKI_OWNER') }}</th>
            <th>{{ _t('FERME_STATS_CONTENT') }}</th>
            <th>{{ _t('FERME_SORT_ACTIVITY') }}</th>
            <th>{{ _t('FERME_STATS_DISK') }}</th>
            <th><span class="ferme-visually-hidden">{{ _t('FERME_WIKI_ACTION') }}</span></th>
          </tr>
        </thead>
        <tbody>
        {% for row in rows %}
          {% set stats = row.stats %}
          <tr class="ferme-row{% if row.status.asleep %} ferme-row--asleep{% endif %}" data-folder="{{ row.folder }}" data-tag="{{ row.tag }}" data-title="{{ row.title }}" data-mail="{{ row.mail }}">
            <td class="ferme-table__check"><input type="checkbox" data-ferme-check aria-label="{{ row.title }}"></td>
            <td class="ferme-table__wiki">
              <a class="ferme-table__title" href="{{ row.viewUrl }}">{{ row.title }}</a>
              {% if row.folder %}
                <a class="ferme-table__folder" href="{{ row.url ?: '#' }}" target="_blank" rel="noopener" title="{{ _t('FERME_OPEN_WIKI') }}">{{ icon('external-link') }} {{ row.folder }}</a>
              {% endif %}
              <div class="ferme-badges">
                {% if row.status.asleep %}<span class="yw-label">{{ icon('moon') }} {{ row.status.label }}</span>{% endif %}
                {% if row.lifetime %}
                  {% if row.lifetime.archived %}
                    <span class="yw-label yw-label--danger" title="{{ _t('FERME_LIFETIME_PURGE_ON') }} {{ row.lifetime.purgeLabel }}">{{ icon('box') }} {{ _t('FERME_LIFETIME_ARCHIVED') }}</span>
                  {% elseif row.lifetime.kind != 'permanent' %}
                    <span class="yw-label{% if row.lifetime.expiring %} yw-label--warning{% else %} yw-label--info{% endif %}">{{ icon('hourglass') }} {{ row.lifetime.label }}{% if row.lifetime.expiresLabel %} · {{ row.lifetime.expiresLabel }}{% endif %}</span>
                  {% endif %}
                {% endif %}
                {% for problem in row.problems %}<span class="yw-label yw-label--danger">{{ icon('alert-triangle') }} {{ problem.label }}</span>{% endfor %}
                {% if row.error %}<span class="yw-label yw-label--danger" title="{{ row.error }}">{{ icon('alert-triangle') }} {{ row.error|length > 60 ? row.error|slice(0, 60) ~ '…' : row.error }}</span>{% endif %}
                {% if stats %}
                  {% if stats.toUpdate %}<span class="yw-label yw-label--danger">{{ icon('refresh') }} {{ _t('FERME_CHIP_TO_UPDATE') }}</span>{% endif %}
                  {% if stats.suspect %}<span class="yw-label yw-label--danger" title="{{ stats.suspectWhy|join(', ') }}">{{ icon('ban') }} {{ _t('FERME_CHIP_SUSPECT') }}</span>{% endif %}
                  {% if stats.spammed %}<span class="yw-label yw-label--warning" title="{{ stats.spamHosts }}">{{ icon('link') }} {{ _t('FERME_CHIP_SPAMMED') }} ({{ stats.spamPages }})</span>{% endif %}
                  {% if stats.neverEdited %}<span class="yw-label">{{ icon('seedling') }} {{ _t('FERME_CHIP_UNCHANGED') }}</span>{% endif %}
                  {% if stats.dormant %}<span class="yw-label">{{ icon('moon') }} {{ _t('FERME_CHIP_DORMANT') }}</span>{% endif %}
                  {% if stats.heavyArchives %}<span class="yw-label yw-label--warning">{{ icon('box') }} {{ _t('FERME_CHIP_HEAVY_ARCHIVES') }}</span>{% endif %}
                  {% if stats.failed %}<span class="yw-label yw-label--danger" title="{{ stats.error }}">{{ icon('alert-triangle') }} {{ _t('FERME_CHIP_FAILED') }}</span>{% endif %}
                {% endif %}
                {% if row.admin %}
                  <span class="yw-label{% if row.admin.present %} yw-label--success{% endif %}" title="{{ _t('FERME_WIKI_ADMIN') }} {{ row.admin.name }}">{{ icon('user') }} {{ row.admin.present ? _t('FERME_ADMIN_PRESENT') : _t('FERME_ADMIN_ABSENT') }}</span>
                {% endif %}
              </div>
            </td>
            <td class="ferme-table__owner">
              {{ row.referent }}
              {% if row.mail %}<a class="ferme-table__mail" href="mailto:{{ row.mail }}">{{ row.mail }}</a>{% endif %}
            </td>
            <td class="ferme-table__numbers">
              {% if stats %}
                <span title="{{ _t('FERME_SORT_ENTRIES') }}">{{ icon('list-details') }} {{ stats.entries }}</span>
                <span title="{{ _t('FERME_SORT_PAGES') }}">{{ icon('file-text') }} {{ stats.pages }}</span>
                <span title="{{ _t('FERME_SORT_USERS') }}">{{ icon('users') }} {{ stats.users }}</span>
              {% else %}
                <span class="ferme-muted">{{ _t('FERME_STATS_NEVER_MEASURED') }}</span>
              {% endif %}
            </td>
            <td class="ferme-table__activity">
              {% if stats %}
                <span class="ferme-sparkline-wrap">{{ stats.sparkline|raw }}</span>
                <span class="ferme-muted">{{ stats.lastActivityAge }}</span>
              {% endif %}
            </td>
            <td class="ferme-table__disk">
              {% if stats %}<span title="{{ stats.diskDetail }}">{{ stats.disk }}</span>{% endif %}
            </td>
            <td class="ferme-table__actions">
              <button type="button" class="yw-btn yw-btn--sm" data-ferme-detail aria-expanded="false" title="{{ _t('FERME_STATS_DETAIL') }}">{{ icon('chevron-down') }}<span class="ferme-visually-hidden">{{ _t('FERME_STATS_DETAIL') }}</span></button>
              <div class="yw-dropdown">
                <button type="button" class="yw-btn yw-btn--sm" data-yw-dropdown-toggle aria-expanded="false" title="{{ _t('FERME_WIKI_ACTION') }}">{{ icon('menu-2') }}<span class="ferme-visually-hidden">{{ _t('FERME_WIKI_ACTION') }}</span></button>
                <ul class="yw-dropdown__menu yw-dropdown__menu--right">
                  {% if row.url %}<li><a href="{{ row.url }}" target="_blank" rel="noopener">{{ icon('external-link') }} {{ _t('FERME_HOOK_OPEN_WIKI') }}</a></li>{% endif %}
                  <li><a href="{{ row.viewUrl }}">{{ icon('eye') }} {{ _t('FERME_HOOK_SEE_ENTRY') }}</a></li>
                  <li><a href="{{ row.editUrl }}">{{ icon('pencil') }} {{ _t('FERME_EDIT_ENTRY') }}</a></li>
                  <li class="yw-dropdown__divider"></li>
                  {{ ferme.actionItems(farmAdmin, lifetimeEnabled, lifetimeKinds, row) }}
                </ul>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if pageLinks is not empty %}
    <nav class="yw-pagination ferme-pagination" aria-label="{{ _t('FERME_PAGES') }}">
      {% for link in pageLinks %}
        <a class="yw-pagination__link{% if link.current %} ferme-pagination__current{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.number }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="yw-modal ferme-modal" id="ferme-wikis-modal" tabindex="-1" role="dialog" aria-labelledby="ferme-modal-title">
    <div class="yw-modal__dialog yw-modal__dialog--lg">
      <div class="yw-modal__content">
        <div class="yw-modal__header">
          <h3 class="yw-modal__title" id="ferme-modal-title"></h3>
          <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="{{ _t('FERME_UPGRADE_CLOSE') }}">&times;</button>
        </div>
        <div class="yw-modal__body ferme-modal__body"></div>
        <div class="yw-modal__footer ferme-modal__footer"></div>
      </div>
    </div>
  </div>
</div>

{% macro actionItems(farmAdmin, lifetimeEnabled, lifetimeKinds, row) %}
  <li><button type="button" data-ferme-action="migrate">{{ icon('refresh') }} {{ _t('FERME_MIGRATE_SELECTED') }}</button></li>
  <li><button type="button" data-ferme-action="refresh-stats">{{ icon('chart-bar') }} {{ _t('FERME_REFRESH_STATS_SELECTED') }}</button></li>
  <li><button type="button" data-ferme-action="archive">{{ icon('download') }} {{ _t('FERME_ARCHIVE_SELECTED') }}</button></li>
  {% if row is null or not row.status.asleep %}
    <li><button type="button" data-ferme-action="hibernate">{{ icon('moon') }} {{ _t('FERME_HIBERNATE_SELECTED') }}</button></li>
  {% endif %}
  {% if row is null or row.status.asleep %}
    <li><button type="button" data-ferme-action="wake">{{ icon('sun') }} {{ _t('FERME_WAKE_SELECTED') }}</button></li>
  {% endif %}
  {% if farmAdmin %}
    {% if row is null or not row.admin or not row.admin.present %}
      <li><button type="button" data-ferme-action="admin-add">{{ icon('user-plus') }} {{ _t('FERME_ADMIN_ADD_SELECTED') }}</button></li>
    {% endif %}
    {% if row is null or not row.admin or row.admin.present %}
      <li><button type="button" data-ferme-action="admin-remove">{{ icon('user') }} {{ _t('FERME_ADMIN_REMOVE_SELECTED') }}</button></li>
    {% endif %}
  {% endif %}
  <li><button type="button" data-ferme-action="clean-spam-dry">{{ icon('eye') }} {{ _t('FERME_CLEAN_DRY_SELECTED') }}</button></li>
  <li><button type="button" data-ferme-action="clean-spam">{{ icon('eraser') }} {{ _t('FERME_CLEAN_SELECTED') }}</button></li>
  <li><button type="button" data-ferme-action="mail">{{ icon('mail') }} {{ _t('FERME_MAIL_SELECTED') }}</button></li>
  {% if lifetimeEnabled %}
    {% for kind in lifetimeKinds %}
      <li><button type="button" data-ferme-action="lifetime" data-ferme-kind="{{ kind.kind }}">{{ icon('hourglass') }} {{ _t('FERME_LIFETIME_TO_' ~ kind.kind|upper) }}</button></li>
    {% endfor %}
  {% endif %}
  <li class="yw-dropdown__divider"></li>
  <li><button type="button" class="ferme-danger" data-ferme-action="delete">{{ icon('trash') }} {{ _t('FERME_DELETE_SELECTED_WIKIS') }}</button></li>
{% endmacro %}
