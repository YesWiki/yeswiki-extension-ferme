{% import _self as ferme %}
{% macro accessControl(posted, needsUser) %}
        <div id="access-control"{% if not needsUser %} class="hide"{% endif %}>
            <input type="text" class="form-control" name="access-username" required{% if not needsUser %} disabled{% endif %} value="{{ posted['access-username']|default('') }}" placeholder="{{ _t('FERME_ACCESS_ID') }}">
            <input type="password" class="form-control" name="access-password" required{% if not needsUser %} disabled{% endif %} placeholder="{{ _t('FERME_ACCESS_PASSWORD') }}">
        </div>
{% endmacro %}
<div class="yeswiki-form">
  <div class="form-group input-{{ field.type}}">
    <label class="control-label col-sm-3">       
        {% if field.required %}<span class="symbole_obligatoire"></span>{% endif %}
        {% if field.hint %}
            <span class="form-help fa fa-question-circle" title="{{ field.hint|raw('html') }}" onclick="$(this).tooltip('toggle')"></span>
        {% endif %}
        {{ field.label }}         
    </label>
    <div class="controls col-sm-9">
        <div class="input-prepend input-group">
            <span class="add-on input-group-addon">{{ rootUrl }}</span>
            {% if created %}
                <input type="text" class="form-control" id="{{ field.name }}" name="{{ field.name }}" required disabled value="{{ value }}" />
                <input type="hidden" name="{{ field.name }}_exists" value="1">
                <input type="hidden" name="{{ field.name }}" value="{{ value }}">
            {% else %}
                <input type="text" class="form-control{% if blamed == field.name %} input-error{% endif %}" id="{{ field.name }}" name="{{ field.name }}" maxlength="50" required value="{{ addressValue }}" oninput="var c = this.selectionStart,r = /[^a-z0-9\-_]/gi, v = this.value;if(r.test(v)) { this.value = v.replace(r, ''); c--; } this.setSelectionRange(c, c);" pattern="[a-zA-Z0-9\-_]+" placeholder="{{ _t('FERME_SITE_NAME') }}" />
            {% endif %}
        </div>
        {% if error and (blamed is null or blamed == field.name) %}
            <span class="help-block text-danger yeswiki-farm-error"><i class="fas fa-exclamation-triangle"></i> {{ error }}</span>
        {% endif %}
    </div>
  </div>
  {% if not created %}
    <div class="yeswiki-farm-section yeswiki-farm-section-user">
        <h5>{{ _t('FERME_ADMIN_USER') }}</h5>
        {% if adminUsername is null or adminUsername is empty %}
        <div class="form-group input-{{ field.type}}">
            <label class="control-label col-sm-3">       
                <span class="symbole_obligatoire"></span>
                {{ _t('FERME_ADMIN_NAME') }}         
            </label>
            <div class="controls col-sm-9">
                <div class="input-prepend input-group">
                    <input type="text" class="form-control{% if blamed == field.name ~ '_wikiname' %} input-error{% endif %}" id="{{ field.name }}_wikiname" name="{{ field.name }}_wikiname" required value="{{ posted[field.name ~ '_wikiname']|default('') }}" placeholder="{{ _t('FERME_ADMIN_NAME') }}">
                </div>
                {% if error and blamed == field.name ~ '_wikiname' %}
                    <span class="help-block text-danger yeswiki-farm-error"><i class="fas fa-exclamation-triangle"></i> {{ error }}</span>
                {% endif %}
            </div>
        </div>
        {% else %}
            <input type="hidden" name="{{ field.name }}_wikiname" value="{{ adminUsername }}">
        {% endif %}

        {% if adminEmail is null or adminEmail is empty %}
        <div class="form-group input-{{ field.type}}">
            <label class="control-label col-sm-3">       
                <span class="symbole_obligatoire"></span>
                {{ _t('FERME_ADMIN_MAIL') }}         
            </label>
            <div class="controls col-sm-9">
                <div class="input-prepend input-group">
                    <input type="email" class="form-control" id="{{ field.name }}_email" name="{{ field.name }}_email" required value="{{ posted[field.name ~ '_email']|default('') }}" placeholder="{{ _t('FERME_ADMIN_MAIL') }}">
                </div>
            </div>
        </div>
         {% else %}
            <input type="hidden" name="{{ field.name }}_email" value="{{ adminEmail }}">
        {% endif %}

        {% if adminPassword is null or adminPassword is empty %}
        <div class="form-group input-{{ field.type}}">
            <label class="control-label col-sm-3">       
                <span class="symbole_obligatoire"></span>
                {{ _t('FERME_ADMIN_PASSWORD') }}         
            </label>
            <div class="controls col-sm-9">
                <div class="input-prepend input-group">
                    <input type="password" class="form-control" id="{{ field.name }}_password" name="{{ field.name }}_password" required placeholder="{{ _t('FERME_ADMIN_PASSWORD') }}">
                </div>
                {% if error %}<span class="help-block">{{ _t('FERME_RETYPE_PASSWORD') }}</span>{% endif %}
                <span class="help-block text-danger"><strong>{{ _t('FERME_ATTENTION') }}</strong> : {{ _t('FERME_REMEMBER_PASSWORD') }}.<br/>
                {{ _t('FERME_TO_LOGIN') }}.</span>
            </div>
        </div>
        {% else %}
            <input type="hidden" name="{{ field.name }}_password" value="{{ adminPassword }}">
        {% endif %}
    </div>

    {% if farmThemes|length > 1 %}
    <div class="yeswiki-farm-section yeswiki-farm-section-themes">
      <div class="row">
        <div class="col-md-6">
            <h5>{{ _t('FERME_GRAPHICAL_THEME') }}</h5>
            <div class="input-radio bazar-radio radio_required">
                {% set selectedTheme = posted['yeswiki-farm-theme'] is defined ? posted['yeswiki-farm-theme'] : farmThemes|keys|first %}
                {% for key, theme in farmThemes %}
                    <div class="radio">
                    <label for="yeswiki-farm-theme-{{ key }}">
                        <input id="yeswiki-farm-theme-{{ key }}" type="radio" value="{{ key }}" name="yeswiki-farm-theme" {% if key == selectedTheme %}checked{% endif %} />
                        <span>{{ theme.label }}</span>
                    </label>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="col-md-6">
            {% for key, theme in farmThemes %}
                {% if theme.screenshot %}
                    <img class="theme-screenshot img-responsive{% if key != selectedTheme %} hide {% endif %}"
                         src="tools/ferme/screenshots/{{ theme.screenshot }}"
                         alt="screenshot for theme {{ theme.label }}" />
                {% endif %}
            {% endfor %}
        </div>
      </div>
    </div>
    {% else %}
    <input type="hidden" name="yeswiki-farm-theme" value="{{ farmThemes|keys|first|default(0) }}">
    {% endif %}

    {% if farmModels|length > 1 %}
    <div class="yeswiki-farm-section yeswiki-farm-section-models">
        <h5>{{ _t('FERME_MODEL_OF_WIKI') }}</h5>
        <div class="input-radio bazar-radio radio_required">
            {% set selectedModel = posted['yeswiki-farm-model'] is defined ? posted['yeswiki-farm-model'] : farmModels|keys|first %}
            {% for key, model in farmModels %}
                <div class="radio">
                <label for="yeswiki-farm-model-{{ key }}">
                    <input id="yeswiki-farm-model-{{ key }}" type="radio" value="{{ key }}" name="yeswiki-farm-model" {% if key == selectedModel %}checked{% endif %} />
                    <span>{{ model }}</span>
                </label>
                </div>
            {% endfor %}
        </div>
    </div>
    {% elseif farmModels|length > 0 %}
    <input type="hidden" name="yeswiki-farm-model" value="{{ farmModels|keys|first }}">
    {% else %}
    <input type="hidden" name="yeswiki-farm-model" value="default-content">
    {% endif %}

    {% set selectedAcl = posted['yeswiki-farm-acls'] is defined ? posted['yeswiki-farm-acls'] : farmAcls|keys|first %}
    {% set needsUser = farmAcls[selectedAcl].create_user|default(false) %}
    {% if farmAcls|length > 1 %}
    <div class="yeswiki-farm-section yeswiki-farm-section-acls">
        <h5>{{ _t('FERME_ACCESS_RIGHTS') }}</h5>
        <div class="input-radio bazar-radio radio_required">
            {% for key, acls in farmAcls %}
                <div class="radio">
                <label for="yeswiki-farm-acls-{{ key }}">
                    <input id="yeswiki-farm-acls-{{ key }}"{% if acls.create_user %} class="create_user"{% endif %} type="radio" value="{{ key }}" name="yeswiki-farm-acls" {% if key == selectedAcl %}checked{% endif %} />
                    <span>{{ acls.label }}</span>
                </label>
                </div>
            {% endfor %}
        </div>
        {{ ferme.accessControl(posted, needsUser) }}
    </div>
    {% else %}
    <input type="hidden" name="yeswiki-farm-acls" value="{{ farmAcls|keys|first|default(0) }}">
    {% if needsUser %}
    <div class="yeswiki-farm-section yeswiki-farm-section-acls">
        <h5>{{ _t('FERME_ACCESS_RIGHTS') }}</h5>
        {{ ferme.accessControl(posted, needsUser) }}
    </div>
    {% endif %}
    {% endif %}

    {% if farmOptions|length > 1 %}
    <div class="yeswiki-farm-section yeswiki-farm-section-options">
        <h5>{{ _t('FERME_EXTRA_OPTIONS') }}</h5>
        {% for key, option in farmOptions %}
        <div class="checkbox">
            <label>
            <input type="checkbox"{% if error ? posted['yeswiki-farm-options' ~ key] is defined : option.checked %} checked{% endif %} name="yeswiki-farm-options{{ key }}" value="{{ key }}" />
            {{ option.label }}
            </label>
        </div>
        {% endfor %}
    </div>
    {% endif %}
  {% endif %}
</div> <!-- end .yeswiki-form -->

<style>
.yeswiki-form {
    background-color:#f3f3f3;
    padding:.5em 1em;
    border-radius:1em;
    margin-bottom:1em;
}
.yeswiki-farm-section {
    margin: 2em 0 1em;
}
.theme-screenshot {
    width: 400px;
    height: 225px;
    object-fit: cover;
}
.bazar-radio {
    margin-bottom:1em
}
.yeswiki-form .input-error {
    border-color: #a94442;
}
.yeswiki-form .yeswiki-farm-error {
    margin-top: .5em;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {

  $('.yeswiki-farm-section-themes input[type="radio"]').click(function() {
      console.log($(this).prop('checked'))
    if ($(this).prop('checked')) {
      $('.theme-screenshot').addClass('hide');
      $('.theme-screenshot:eq('+parseInt($(this).val())+')').removeClass('hide');
    }
  });

  var $aclRadios = $('input[type="radio"][name="yeswiki-farm-acls"]');

  function toggleAccessControl() {
    var $block = $('#access-control');
    if (!$block.length || !$aclRadios.length) return;
    var needsUser = $aclRadios.filter(':checked').hasClass('create_user');
    $block.toggleClass('hide', !needsUser);
    $block.find('input').prop('disabled', !needsUser);
  }

  $aclRadios.on('change', toggleAccessControl);
  toggleAccessControl();

  $('#radioListeOuiNonoui').on('click', function(e) {
    $('.btn-primary[type="submit"]').removeAttr('disabled');
  });

  // we don't allow to submit before CGUs and RGPD consent 
  $('#radioListeOuiNonnon').on('click', function(e) {
    $('.btn-primary[type="submit"]').attr('disabled','disabled');
  });
  $('#radioListeOuiNonnon').click();

});
</script>