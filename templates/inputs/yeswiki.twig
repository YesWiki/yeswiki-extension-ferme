{{ include_css('extensions/ferme/styles/ferme.css') }}
{{ include_javascript('extensions/ferme/javascripts/wiki-form.js') }}
<div class="ferme-form" data-ferme-form>
  <div class="yw-form-group input-{{ field.type }}">
    <label class="yw-form-label" for="{{ field.name }}">
      {% if field.required %}<span class="symbole_obligatoire"></span>{% endif %}
      {% if field.hint %}<span class="tooltip_aide" tabindex="0" role="img" aria-label="{{ field.hint|striptags }}" data-yw-tooltip="{{ field.hint|striptags }}">{{ icon('help-circle') }}</span>{% endif %}
      {{ field.label|raw }}
    </label>
    <div class="controls">
      <div class="ferme-address">
        <span class="ferme-address__root">{{ rootUrl }}</span>
        {% if created %}
          <input type="text" class="yw-input" id="{{ field.name }}" value="{{ value }}" disabled>
          <input type="hidden" name="{{ field.name }}" value="{{ value }}">
          <input type="hidden" name="{{ field.name }}_exists" value="1">
        {% else %}
          <input type="text" class="yw-input{% if blamed == field.name %} ferme-input--error{% endif %}" id="{{ field.name }}" name="{{ field.name }}" maxlength="50" required pattern="[a-zA-Z0-9_\-]+" value="{{ addressValue }}" placeholder="{{ _t('FERME_SITE_NAME') }}" data-ferme-slug autocomplete="off">
        {% endif %}
      </div>
      {% if error and (blamed is null or blamed == field.name) %}
        <p class="yw-alert yw-alert--danger ferme-form__error">{{ icon('alert-triangle') }} {{ error }}</p>
      {% endif %}
    </div>
  </div>

  {% if not created %}
    <fieldset class="ferme-form__section">
      <legend>{{ _t('FERME_ADMIN_USER') }}</legend>
      {% if adminUsername is empty %}
        <div class="yw-form-group">
          <label class="yw-form-label" for="{{ field.name }}_wikiname"><span class="symbole_obligatoire"></span> {{ _t('FERME_ADMIN_NAME') }}</label>
          <div class="controls">
            <input type="text" class="yw-input{% if blamed == field.name ~ '_wikiname' %} ferme-input--error{% endif %}" id="{{ field.name }}_wikiname" name="{{ field.name }}_wikiname" required value="{{ posted[field.name ~ '_wikiname']|default('') }}" placeholder="{{ _t('FERME_ADMIN_NAME') }}" autocomplete="username">
            {% if error and blamed == field.name ~ '_wikiname' %}<p class="yw-alert yw-alert--danger ferme-form__error">{{ icon('alert-triangle') }} {{ error }}</p>{% endif %}
          </div>
        </div>
      {% else %}
        <input type="hidden" name="{{ field.name }}_wikiname" value="{{ adminUsername }}">
      {% endif %}

      {% if adminEmail is empty %}
        <div class="yw-form-group">
          <label class="yw-form-label" for="{{ field.name }}_email"><span class="symbole_obligatoire"></span> {{ _t('FERME_ADMIN_MAIL') }}</label>
          <div class="controls">
            <input type="email" class="yw-input{% if blamed == field.name ~ '_email' %} ferme-input--error{% endif %}" id="{{ field.name }}_email" name="{{ field.name }}_email" required value="{{ posted[field.name ~ '_email']|default('') }}" placeholder="{{ _t('FERME_ADMIN_MAIL') }}" autocomplete="email">
            {% if error and blamed == field.name ~ '_email' %}<p class="yw-alert yw-alert--danger ferme-form__error">{{ icon('alert-triangle') }} {{ error }}</p>{% endif %}
          </div>
        </div>
      {% else %}
        <input type="hidden" name="{{ field.name }}_email" value="{{ adminEmail }}">
      {% endif %}

      {% if adminPassword is empty %}
        <div class="yw-form-group">
          <label class="yw-form-label" for="{{ field.name }}_password"><span class="symbole_obligatoire"></span> {{ _t('FERME_ADMIN_PASSWORD') }}</label>
          <div class="controls">
            <input type="password" class="yw-input{% if blamed == field.name ~ '_password' %} ferme-input--error{% endif %}" id="{{ field.name }}_password" name="{{ field.name }}_password" required minlength="5" placeholder="{{ _t('FERME_ADMIN_PASSWORD') }}" autocomplete="new-password">
            {% if error and blamed == field.name ~ '_password' %}<p class="yw-alert yw-alert--danger ferme-form__error">{{ icon('alert-triangle') }} {{ error }}</p>{% endif %}
            {% if error %}<p class="ferme-muted">{{ _t('FERME_RETYPE_PASSWORD') }}</p>{% endif %}
            <p class="ferme-form__hint"><strong>{{ _t('FERME_ATTENTION') }}</strong> : {{ _t('FERME_REMEMBER_PASSWORD') }}.</p>
          </div>
        </div>
      {% endif %}
    </fieldset>

    {% if farmThemes|length > 1 %}
      {% set selectedTheme = posted['yeswiki-farm-theme'] ?? farmThemes|keys|first %}
      <fieldset class="ferme-form__section ferme-form__themes">
        <legend>{{ _t('FERME_GRAPHICAL_THEME') }}</legend>
        <div class="ferme-form__choices">
          {% for key, theme in farmThemes %}
            <div class="radio">
              <label for="yeswiki-farm-theme-{{ key }}">
                <input id="yeswiki-farm-theme-{{ key }}" type="radio" name="yeswiki-farm-theme" value="{{ key }}"{% if key == selectedTheme %} checked{% endif %} data-ferme-theme="{{ key }}">
                <span>{{ theme.label }}</span>
              </label>
            </div>
          {% endfor %}
        </div>
        <div class="ferme-form__screenshots">
          {% for key, theme in farmThemes %}
            {% if theme.screenshot %}
              <img class="ferme-form__screenshot" src="{{ config.base_url|split('?')|first }}custom/ferme/screenshots/{{ theme.screenshot }}" alt="{{ theme.label }}" data-ferme-screenshot="{{ key }}"{% if key != selectedTheme %} hidden{% endif %}>
            {% endif %}
          {% endfor %}
        </div>
      </fieldset>
    {% else %}
      <input type="hidden" name="yeswiki-farm-theme" value="{{ farmThemes|keys|first|default(0) }}">
    {% endif %}

    {% if farmModels|length > 1 %}
      {% set selectedModel = posted['yeswiki-farm-model'] ?? farmModels|keys|first %}
      <fieldset class="ferme-form__section">
        <legend>{{ _t('FERME_MODEL_OF_WIKI') }}</legend>
        {% for key, model in farmModels %}
          <div class="radio">
            <label for="yeswiki-farm-model-{{ key }}">
              <input id="yeswiki-farm-model-{{ key }}" type="radio" name="yeswiki-farm-model" value="{{ key }}"{% if key == selectedModel %} checked{% endif %}>
              <span>{{ model }}</span>
            </label>
          </div>
        {% endfor %}
      </fieldset>
    {% else %}
      <input type="hidden" name="yeswiki-farm-model" value="{{ farmModels|keys|first|default('default-content') }}">
    {% endif %}

    {% set selectedAcl = posted['yeswiki-farm-acls'] ?? farmAcls|keys|first %}
    {% set needsUser = farmAcls[selectedAcl].create_user|default(false) %}
    {% if farmAcls|length > 1 or needsUser %}
      <fieldset class="ferme-form__section">
        <legend>{{ _t('FERME_ACCESS_RIGHTS') }}</legend>
        {% if farmAcls|length > 1 %}
          {% for key, acl in farmAcls %}
            <div class="radio">
              <label for="yeswiki-farm-acls-{{ key }}">
                <input id="yeswiki-farm-acls-{{ key }}" type="radio" name="yeswiki-farm-acls" value="{{ key }}"{% if key == selectedAcl %} checked{% endif %}{% if acl.create_user %} data-ferme-create-user{% endif %}>
                <span>{{ acl.label }}</span>
              </label>
            </div>
          {% endfor %}
        {% else %}
          <input type="hidden" name="yeswiki-farm-acls" value="{{ selectedAcl }}"{% if needsUser %} data-ferme-create-user{% endif %}>
        {% endif %}
        <div class="ferme-form__access" data-ferme-access{% if not needsUser %} hidden{% endif %}>
          <input type="text" class="yw-input" name="access-username" required{% if not needsUser %} disabled{% endif %} value="{{ posted['access-username']|default('') }}" placeholder="{{ _t('FERME_ACCESS_ID') }}" aria-label="{{ _t('FERME_ACCESS_ID') }}">
          <input type="password" class="yw-input" name="access-password" required{% if not needsUser %} disabled{% endif %} placeholder="{{ _t('FERME_ACCESS_PASSWORD') }}" aria-label="{{ _t('FERME_ACCESS_PASSWORD') }}">
        </div>
      </fieldset>
    {% else %}
      <input type="hidden" name="yeswiki-farm-acls" value="{{ selectedAcl|default(0) }}">
    {% endif %}

    {% if lifetimes|length > 0 %}
      {% set selectedLifetime = posted['yeswiki-farm-lifetime'] ?? lifetimes|keys|first %}
      <fieldset class="ferme-form__section">
        <legend>{{ _t('FERME_LIFETIME') }}</legend>
        {% for key, label in lifetimes %}
          <div class="radio">
            <label for="yeswiki-farm-lifetime-{{ key }}">
              <input id="yeswiki-farm-lifetime-{{ key }}" type="radio" name="yeswiki-farm-lifetime" value="{{ key }}"{% if key == selectedLifetime %} checked{% endif %}>
              <span>{{ label }}</span>
            </label>
          </div>
        {% endfor %}
      </fieldset>
    {% endif %}

    {% if farmOptions|length > 0 %}
      {% set postedOptions = posted['yeswiki-farm-options']|default([]) %}
      <fieldset class="ferme-form__section">
        <legend>{{ _t('FERME_EXTRA_OPTIONS') }}</legend>
        {% for key, option in farmOptions %}
          <div class="checkbox">
            <label>
              <input type="checkbox" name="yeswiki-farm-options[]" value="{{ key }}"{% if (error ? key in postedOptions : option.checked) %} checked{% endif %}>
              {{ option.label }}
            </label>
          </div>
        {% endfor %}
      </fieldset>
    {% endif %}
  {% endif %}
</div>
