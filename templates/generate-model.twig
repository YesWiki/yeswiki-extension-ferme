{% import _self as ferme %}
{{ include_css('extensions/ferme/styles/ferme.css') }}
<div class="ferme ferme-models">
  {% for message in messages %}
    <p class="yw-alert yw-alert--{{ message.type }}">{{ message.message }}</p>
  {% endfor %}

  <p class="ferme-intro">{{ _t('FERME_MODELS_INTRO') }}</p>

  <h3>{{ _t('FERME_AVAILABLE_MODELS') }}</h3>
  {% if models is empty %}
    <p class="ferme-muted">{{ _t('FERME_MODELS_NONE') }}</p>
  {% else %}
    <div class="ferme-table-wrap">
      <table class="yw-table ferme-table">
        <thead>
          <tr>
            <th>{{ _t('FERME_MODEL_LABEL') }}</th>
            <th>{{ _t('FERME_MODEL_SOURCE') }}</th>
            <th>{{ _t('FERME_STATS_DISK') }}</th>
            <th><span class="sr-only">{{ _t('FERME_WIKI_ACTION') }}</span></th>
          </tr>
        </thead>
        <tbody>
          {% for model in models %}
            <tr>
              <td>
                <form method="post" class="ferme-models__update">
                  <input type="hidden" name="csrf-token" value="{{ csrfToken }}">
                  <input type="hidden" name="ferme_model_action" value="update">
                  <input type="hidden" name="name" value="{{ model.name }}">
                  <input type="text" class="yw-input" name="label" value="{{ model.label }}" aria-label="{{ _t('FERME_MODEL_LABEL') }}">
                  <label class="ferme-models__offered"><input type="checkbox" name="offered" value="1"{% if model.offered %} checked{% endif %}> {{ _t('FERME_PROPOSED_MODEL') }}</label>
                  <button type="submit" class="yw-btn yw-btn--sm">{{ icon('device-floppy') }} {{ _t('FERME_MODEL_SAVE') }}</button>
                </form>
                <code class="ferme-muted">{{ model.name }}</code>
              </td>
              <td>
                {% if model.source %}<a href="{{ model.source }}" target="_blank" rel="noopener">{{ model.source }}</a>{% endif %}
                <div class="ferme-muted">{{ model.createdAt }}</div>
              </td>
              <td>{{ model.size }}</td>
              <td>
                <form method="post" onsubmit="return confirm({{ _t('FERME_CONFIRM_DELETE_MODEL')|json_encode }})">
                  <input type="hidden" name="csrf-token" value="{{ csrfToken }}">
                  <input type="hidden" name="ferme_model_action" value="delete">
                  <input type="hidden" name="name" value="{{ model.name }}">
                  <button type="submit" class="yw-btn yw-btn--sm yw-btn--danger">{{ icon('trash') }} {{ _t('FERME_DELETE') }}</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  <div class="ferme-models__new">
    <form method="post" class="ferme-panel">
      <h3>{{ _t('FERME_MODEL_FROM_WIKI') }}</h3>
      <p class="ferme-muted">{{ _t('FERME_MODEL_FROM_WIKI_INTRO') }}</p>
      <input type="hidden" name="csrf-token" value="{{ csrfToken }}">
      <input type="hidden" name="ferme_model_action" value="from-wiki">
      {% if wikis is empty %}
        <p class="yw-alert yw-alert--info">{{ _t('FERME_NO_WIKIS') }}</p>
      {% else %}
        <div class="yw-form-group">
          <label class="yw-form-label" for="ferme-model-folder">{{ _t('FERME_WIKI') }}</label>
          <select class="yw-input" id="ferme-model-folder" name="folder" required>
            {% for folder, label in wikis %}<option value="{{ folder }}">{{ label }}</option>{% endfor %}
          </select>
        </div>
        {{ ferme.naming('wiki') }}
        <button type="submit" class="yw-btn yw-btn--primary">{{ icon('copy') }} {{ _t('FERME_MODEL_CREATE') }}</button>
      {% endif %}
    </form>

    <form method="post" class="ferme-panel">
      <h3>{{ _t('FERME_MODEL_FROM_REMOTE') }}</h3>
      <p class="ferme-muted">{{ _t('FERME_MODEL_CREDENTIALS_HINT') }}</p>
      <input type="hidden" name="csrf-token" value="{{ csrfToken }}">
      <input type="hidden" name="ferme_model_action" value="from-remote">
      <div class="yw-form-group">
        <label class="yw-form-label" for="ferme-model-url">{{ _t('FERME_MODEL_REMOTE_URL') }}</label>
        <input type="url" class="yw-input" id="ferme-model-url" name="url" required placeholder="https://example.org/?PagePrincipale">
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label" for="ferme-model-admin">{{ _t('FERME_MODEL_ADMIN_USER') }}</label>
        <input type="text" class="yw-input" id="ferme-model-admin" name="remote_admin" required autocomplete="off">
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label" for="ferme-model-password">{{ _t('FERME_MODEL_ADMIN_PASSWORD') }}</label>
        <input type="password" class="yw-input" id="ferme-model-password" name="remote_password" required autocomplete="off">
      </div>
      {{ ferme.naming('remote') }}
      <button type="submit" class="yw-btn yw-btn--primary">{{ icon('download') }} {{ _t('FERME_MODEL_CREATE') }}</button>
    </form>
  </div>
</div>

{% macro naming(prefix) %}
  <div class="yw-form-group">
    <label class="yw-form-label" for="ferme-model-{{ prefix }}-name">{{ _t('FERME_MODEL_NAME') }}</label>
    <input type="text" class="yw-input" id="ferme-model-{{ prefix }}-name" name="name" required pattern="[a-zA-Z0-9-]+" placeholder="association">
  </div>
  <div class="yw-form-group">
    <label class="yw-form-label" for="ferme-model-{{ prefix }}-label">{{ _t('FERME_MODEL_LABEL') }}</label>
    <input type="text" class="yw-input" id="ferme-model-{{ prefix }}-label" name="label" placeholder="{{ _t('FERME_MODEL_LABEL_PLACEHOLDER') }}">
  </div>
{% endmacro %}
