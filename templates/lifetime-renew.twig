{{ include_css('extensions/ferme/styles/ferme.css') }}
<div class="ferme ferme-renew">
  <h2>{{ _t('FERME_LIFETIME_RENEW_TITLE') }}</h2>
  {% if error %}
    <p class="yw-alert yw-alert--danger">{{ error }}</p>
  {% endif %}
  {% if entry %}
    <p><strong>{{ entry.title }}</strong> · {{ label }}</p>
    {% if done %}
      <p class="yw-alert yw-alert--success">{{ _t('FERME_LIFETIME_RENEWED', {date: state.expiresAt|date('d/m/Y')}) }}</p>
    {% elseif state and not state.archived and state.expiresAt %}
      <p>{{ _t('FERME_LIFETIME_EXPIRES_ON', {date: state.expiresAt|date('d/m/Y')}) }}</p>
    {% endif %}
    {% if stats %}
      <p class="ferme-muted">{{ _t('FERME_STATS_REFRESHED', {entries: stats.entries|default(0), pages: stats.pages|default(0), users: stats.users|default(0)}) }}</p>
    {% endif %}
    {% if not done and state and state.canRenew %}
      <form method="post" action="{{ action }}">
        <input type="hidden" name="id" value="{{ entry.tag }}">
        <input type="hidden" name="token" value="{{ token }}">
        <button type="submit" class="yw-btn yw-btn--primary">{{ icon('repeat') }} {{ _t('FERME_LIFETIME_RENEW') }}</button>
      </form>
    {% endif %}
  {% endif %}
  {% if donateUrl %}
    <p><a class="yw-btn yw-btn--success" href="{{ donateUrl }}" target="_blank" rel="noopener">{{ icon('heart') }} {{ _t('FERME_LIFETIME_DONATE') }}</a></p>
  {% endif %}
</div>
