{% extends "@core/layouts/field.twig" %}

{% block label %}{{ _t('FERME_ACCESS_WIKI') }}{% endblock %}

{% block value %}
  {% if url %}
    <a class="yw-btn yw-btn--primary" href="{{ url }}" target="_blank" rel="noopener">{{ icon('external-link') }} {{ url }}</a>
  {% endif %}
  {% if lifetime %}
    <p class="ferme-lifetime">
      {% if lifetime.archived %}
        <span class="yw-label yw-label--danger">{{ _t('FERME_LIFETIME_ARCHIVED') }}</span>
        {{ _t('FERME_LIFETIME_ARCHIVED_ON', {date: lifetime.archivedAt|date('d/m/Y'), purge: lifetime.purgeAt|date('d/m/Y')}) }}
      {% else %}
        <span class="yw-label{% if lifetime.expiring %} yw-label--warning{% endif %}">{{ lifetimeLabel }}</span>
        {% if lifetime.expiresAt %}{{ _t('FERME_LIFETIME_EXPIRES_ON', {date: lifetime.expiresAt|date('d/m/Y')}) }}{% endif %}
        {% if renewUrl %}
          <a class="yw-btn yw-btn--sm yw-btn--warning" href="{{ renewUrl }}">{{ icon('repeat') }} {{ _t('FERME_LIFETIME_RENEW') }}</a>
        {% endif %}
      {% endif %}
    </p>
  {% endif %}
{% endblock %}
